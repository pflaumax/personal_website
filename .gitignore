.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
# The whole directory, not just settings.local.json: it currently holds only
# machine-local things (that file and RESUME.md). If a shared project config
# ever lands here — .claude/settings.json, agents, skills — this needs
# narrowing again so those can be tracked.
.claude/

