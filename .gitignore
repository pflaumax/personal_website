.mypy_cache/
# Ruff writes its own .gitignore inside the cache, so this is belt and braces —
# but .mypy_cache/ and .pytest_cache/ are listed on the same reasoning and the
# entry costs nothing if that behaviour ever changes.
.ruff_cache/

# Working notes: a decision record and a to-do list, useful while the work is in
# flight and noise in a public repo. The durable rules belong in CLAUDE.md and
# the user-facing summary in README.md, both of which are tracked.
NOTES-*.md
/db_backup/

# Database dumps anywhere in the tree. This repo is public and a dump carries
# password hashes and session keys — /db_backup/ alone is one stray `mv` away
# from leaking them.
*.dump
*.sql.gz
