# Project settings
SECRET_KEY=secret_key_here
DEBUG=False
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# Custom admin URL path (mandatory — settings.py raises at import if unset)
DJANGO_ADMIN_URL=change-me-to-a-secret-path

# Optional: log level for the root logger (default INFO)
LOG_LEVEL=INFO

# Database (optional — defaults to local SQLite if unset)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# AWS S3 media storage (optional — defaults to local filesystem if unset)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Django Superuser Credentials
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=password_here
